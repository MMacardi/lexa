# --- Database ---
# Local dev points at the Docker Compose Postgres (see docker-compose.yml).
# Host port is 5433 to avoid clashing with a native Postgres on 5432.
# In production this is replaced by Railway's managed connection string.
DATABASE_URL="postgresql://vocab:vocab@localhost:5433/vocab?schema=public"

# --- Server ---
PORT=3000
CORS_ORIGIN="http://localhost:3001"

# --- LLM: Qwen (Alibaba Bailian) ---
BAILIAN_API_KEY=""
BAILIAN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# --- Search ---
# Only used when the focus pass is off (see FOCUS_MODE); optional either way.
TAVILY_API_KEY=""

# The HSK focus pass. On (the default) web-mined examples are off and every
# example is composed on the learner's level. "off" restores web mining.
# Keep it in step with the frontend's NEXT_PUBLIC_FOCUS_MODE.
FOCUS_MODE="on"

# --- Telegram ---
# Local development runs its OWN test bot, never @onomikabot. Only one process can
# poll a bot token: a local backend on the prod token makes Telegram cut off prod
# (409 Conflict: late replies and failed logins for real learners), and its
# reminder loop would message real learners twice. Outside NODE_ENV=production
# the backend refuses to run the prod bot anyway (TELEGRAM_PROD_BOT below).
#   1. Telegram → @BotFather → /newbot → e.g. "Onomika Dev", username onomika_dev_bot
#   2. Paste its token here and set ENABLE_TELEGRAM_BOT="true"
#   3. Put the same username in frontend/.env.local → NEXT_PUBLIC_BOT_USERNAME
#   4. Open the bot and press Start once, so it may message you (bug reports, /remind)
# Railway sets the @onomikabot token and ENABLE_TELEGRAM_BOT=true (DEPLOY.md).
TELEGRAM_BOT_TOKEN=""
ENABLE_TELEGRAM_BOT="false"
# The production bot's username: a non-production backend won't run it. Empty = no guard.
TELEGRAM_PROD_BOT="onomikabot"

# --- Auth ---
# REQUIRED in production: the server refuses to boot if this is left at the dev default.
JWT_SECRET=""
# "true" in production so the session/beta cookies are Secure + SameSite=None (cross-site).
COOKIE_SECURE="false"
# Public URL of the frontend, used to build email magic-links.
FRONTEND_URL="http://localhost:3001"

# --- Closed beta ---
# Comma-separated telegramIds that are always Pro (owner / comped friends).
PRO_ALLOWLIST=""
# The single shared beta code a guest enters BEFORE login. Empty disables the
# pre-login unlock screen (single-use invite codes still work). Example: ONOMIKA2026
BETA_KEY=""
# Reverse-proxy hops in front of the API (for per-guest rate limits). Empty =
# 2 in production (Vercel -> Railway), 0 locally.
TRUST_PROXY_HOPS=""

# --- Admin dashboard ---
# Comma-separated telegramIds allowed to open /admin. Empty → falls back to
# PRO_ALLOWLIST, so the owner always has access.
ADMIN_TELEGRAM_IDS=""

# --- Email (magic-link sign-in + owner feedback) ---
# Leave SMTP_URL empty in dev: mail is logged, not sent (and the magic link is
# returned in the API response only when ALLOW_DEV_LOGIN=true).
SMTP_URL=""                       # smtp://user:pass@host:port  (e.g. QQ/163/Yandex SMTP)
EMAIL_FROM="Onomika <no-reply@onomika.app>"
FEEDBACK_EMAIL=""                 # where in-app bug reports go (else delivered via Telegram)
FEEDBACK_TELEGRAM_CHAT=""         # fallback channel; empty → first id in PRO_ALLOWLIST
