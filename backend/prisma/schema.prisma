generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  telegramId  String       @unique
  firstName   String?
  lastName    String?
  username    String?
  photoUrl    String?
  authVia     String       @default("dev") // "telegram" | "dev"
  createdAt   DateTime     @default(now())
  words       Word[]
  collections Collection[]
  importJobs  ImportJob[]
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  words     Word[]   @relation("CollectionWords")

  @@unique([userId, name])
  @@index([userId])
}

model Word {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  word         String
  sourceLang   String    @default("en")
  targetLang   String    @default("zh")
  phonetic     String?
  partOfSpeech String?
  meaningZh    String?
  collocations String[]
  synonyms     String[]
  antonyms     String[]
  reviewCount  Int       @default(0)
  nextReviewAt DateTime?
  createdAt    DateTime  @default(now())
  examples     Example[]
  collections  Collection[] @relation("CollectionWords")

  // Duplicates are allowed on purpose: a user may keep several cards for the
  // same spelling (different senses, contexts, or a fresh repetition). So there
  // is no (userId, word) unique constraint — just an index for fast lookups.
  @@index([userId])
}

model ReviewEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Example {
  id         String   @id @default(cuid())
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceEn String
  sentenceZh String
  sourceName String
  sourceUrl  String
  createdAt  DateTime @default(now())
}

// Durable Postgres-backed work queue for optional AI enrichment after a bulk
// import. Unlike an in-memory Promise, a job survives a Railway restart.
model ImportJob {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String   @default("queued") // queued | processing | completed | failed
  total            Int
  processed        Int      @default(0)
  generateDetails  Boolean  @default(false)
  generateExamples Boolean  @default(false)
  level            String? // learner CEFR level for example difficulty
  exampleStyle     String? // news | casual | dialogue | literary
  cards            Json
  errors           String[]
  errorMessage     String?
  createdAt        DateTime @default(now())
  startedAt        DateTime?
  leaseUntil       DateTime?
  completedAt      DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}
