generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  telegramId  String       @unique
  firstName   String?
  lastName    String?
  // A display name the learner set themselves; overrides firstName/username in the UI.
  displayName String?
  // Privacy: hide the email / @username from what friends can see.
  hideEmail   Boolean   @default(false)
  hideTag     Boolean   @default(false)
  // Social privacy: who can open my profile (stats, activity graph, languages) and
  // who sees my shared decks listed on it / in friends' Community feed.
  // "hidden" | "friends" | "everyone". A deck's own visibility still gates access.
  profileVisibility String @default("friends")
  decksVisibility   String @default("friends")
  username    String?
  photoUrl    String?
  email       String?      // set for Google / email-magic-link accounts
  authVia     String       @default("dev") // "telegram" | "google" | "email" | "dev"
  // Billing plan. "free" = daily AI-action cap; "pro" = uncapped. planUntil null
  // means no expiry (e.g. comped beta friends); a date = paid until then.
  plan        String       @default("free")
  planUntil   DateTime?
  // Default language pair for server-side surfaces that have no localStorage —
  // notably the Telegram tutor bot (chat + review). Null until first resolved.
  preferredSource String?
  preferredTarget String?
  // The learner model proper. These four lived in localStorage, so the bot and
  // every other server-side surface were blind to them and a new device started
  // from scratch. Null means "never set": the client keeps its local value and
  // uploads it on first sync, so nothing is lost for existing accounts.
  // levels = { [sourceLang]: "A1".."C2" }; nativeLang = the language they already
  // know; dailyGoal = cards per day; retention = FSRS desired retention.
  levels      Json?
  nativeLang  String?
  dailyGoal   Int?
  retention   Float?
  // The exam goal the readiness mark is measured against: which HSK list
  // ("2.0" | "3.0") and which level on it (1–6, or 7 = the 3.0 7–9 band).
  // Null until the learner picks one.
  hskVersion  String?
  hskTarget   Int?
  // A field the learner wants to follow beside the exam ("AI"), and the words
  // picked for it — [{word, pinyin, meaning, fromText, known, hsk}], best first.
  // Today's words take a few a day from the pool (BACKLOG "Topic words beside
  // the exam words"). Null until they name one.
  topic       String?
  topicPool   Json?
  // Telegram chat id for proactive messages (review reminders). Set on /start.
  botChatId   String?
  // Hour of day (0–23, server time) the learner wants their review nudge, or null
  // for no reminders. Chosen in-chat via the Reminders button.
  reminderHour Int?
  // Which weekdays the nudge fires on: CSV of getDay() ints (0=Sun..6=Sat). Empty
  // string means every day (the default).
  reminderDays String @default("")
  // Social: a short code others use to add you as a friend, and who referred you.
  referralCode String?     @unique
  referredById String?
  // Closed-beta gate: a user must redeem an invite code before the app's data/AI
  // routes open up. Grandfathered to true for everyone present at launch.
  invited     Boolean      @default(false)
  invitedAt   DateTime?
  createdAt   DateTime     @default(now())
  words       Word[]
  collections Collection[]
  importJobs  ImportJob[]
  identities  AuthIdentity[]
  readerTexts ReaderText[]
  sentFriendships Friendship[] @relation("SentFriendships")
  recvFriendships Friendship[] @relation("RecvFriendships")
  coachMemories CoachMemory[]
  sceneSessions SceneSession[]
  inviteCodes InviteCode[]
  folders     Folder[]
  collectionAdds CollectionAdd[]
  deckReports    DeckReport[]
  placementAnswers PlacementAnswer[]
}

// Coach memory — what the personal mentor remembers about the learner across
// sessions, so it acts like a real agent, not a stateless chat. Scoped PER SOURCE
// LANGUAGE: an IELTS goal set while practising English must not be injected into
// their Chinese drills. `goal` and `interests` are learner-set; `notes` is a short,
// model-maintained summary of recurring mistakes / preferences, capped in length.
model CoachMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lang      String // source-language code this memory belongs to ("en", "zh", …)
  goal      String   @default("")
  interests String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lang])
  @@index([userId])
}

// A friend link between two users. `requester` sent it; `addressee` accepts. Once
// accepted, either side can see the other's public profile (languages + badges).
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending") // pending | accepted
  createdAt   DateTime @default(now())
  requester   User     @relation("SentFriendships", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("RecvFriendships", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// A sign-in method linked to an account. One user can have several (telegram +
// google + email), so any of them logs into the same account. `subject` is the
// provider-specific id: telegram numeric id, or the verified email address.
model AuthIdentity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   // "telegram" | "google" | "email" | "dev"
  subject   String
  createdAt DateTime @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

// A single-use closed-beta invite code. The owner generates a batch offline
// (scripts/generate-invites.mjs) and sends them to testers; redeeming one marks
// the user `invited` and consumes the code. `redeemedById` is SET NULL (not
// cascade) so deleting a user keeps the code's audit trail.
model InviteCode {
  id           String    @id @default(cuid())
  code         String    @unique
  note         String? // optional human label ("for Anya", "TG group")
  createdBy    String?
  redeemedById String?
  redeemedBy   User?     @relation(fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([redeemedById])
}

// A one-level folder of collections ("HSK4" holding "adjectives", "verbs"…).
// Folders hold collections, never other folders.
model Folder {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())
  collections Collection[]

  @@unique([userId, name])
  @@index([userId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  words     Word[]   @relation("CollectionWords")
  // Social layer. Others can only READ a shared collection; writing stays owner-only.
  //   private — owner only (default) · friends — accepted friends
  //   code    — anyone holding `shareCode` · public — listed in Community
  visibility  String  @default("private")
  shareCode   String? @unique // minted the first time the collection is shared
  description String?
  folderId    String?
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  // Set when this collection was made by copying someone's deck (credit + dedupe).
  copiedFromId String?
  // Onomika Library seed decks: `slug` keys the seed entry, `seedVersion` lets a
  // redeploy refresh an edited deck; `mikaPick` shows "Picked by Mika".
  slug        String?  @unique
  seedVersion Int?
  mikaPick    Boolean  @default(false)
  adds        CollectionAdd[]
  // Moderation: set when an admin took this deck out of Community. The owner can
  // still share it with friends or by code, but can't make it public again.
  delistedAt  DateTime?
  reports     DeckReport[]

  @@unique([userId, name])
  @@index([userId])
  @@index([visibility])
}

// A real learner took words from a shared deck (whole deck or single words). One
// row per (deck, learner); `lastAt` is bumped on every take, so "added by N
// learners" = row count and "popular this week" = rows with a recent lastAt.
model CollectionAdd {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  lastAt       DateTime   @default(now())

  @@unique([collectionId, userId])
  @@index([lastAt])
}

// A learner flagged a deck they can see (spam, offensive, wrong content). One row
// per (deck, reporter). Decks with several open reports drop out of the Community
// lists until the admin reviews them: dismiss (keep) or delist (take it down).
model DeckReport {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  reporterId   String
  reporter     User       @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason       String // spam | offensive | wrong | other
  note         String?
  status       String     @default("open") // open | dismissed | delisted
  createdAt    DateTime   @default(now())
  resolvedAt   DateTime?

  @@unique([collectionId, reporterId])
  @@index([status])
}

model Word {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  word         String
  sourceLang   String    @default("en")
  targetLang   String    @default("zh")
  phonetic     String?
  partOfSpeech String?
  meaningZh    String?
  collocations String[]
  synonyms     String[]
  antonyms     String[]
  notes        String?   // free-form personal notes (P.S.), user-authored
  explainCache String?   // cached AI "explain / when to use" text; cleared on meaningful edits
  senses       Json?     // cached word-page senses { v, list: [{pos, meaning, phrases[]}] }; cleared when the word/pair changes
  familyAt     DateTime? // when synonyms/antonyms were filled in for a card that arrived without them (library decks); set even when the answer was empty, so we ask once
  reviewCount  Int       @default(0)
  nextReviewAt DateTime? // kept in sync with FSRS `due` so existing due-logic works
  // FSRS scheduler state (ts-fsrs). null stability = never reviewed (new card).
  stability     Float?
  difficulty    Float?
  due           DateTime?
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0=New 1=Learning 2=Review 3=Relearning
  learningSteps Int       @default(0)
  lastReview    DateTime?
  // Production ledger, denormalised from ProductionEvent so the "can use" count
  // and the per-card badge are one query. Recognition state (above) is untouched
  // by it: a word can be due for review and still be one you can use, or vice versa.
  produceAttempts Int       @default(0)
  produceCorrect  Int       @default(0)
  produceStreak   Int       @default(0) // consecutive correct uses; a wrong one resets it
  lastProducedAt  DateTime?
  // When the word crossed into "can use" (two correct uses on different days).
  // Null = not there yet, or a wrong attempt took it back — the honest number the
  // readiness mark shows, so it is allowed to go down.
  canUseAt        DateTime?
  createdAt    DateTime  @default(now())
  // Credit for a card copied from someone's shared deck ("from @anya's HSK4").
  // Snapshotted as text so it survives the source deck being renamed or deleted.
  sharedFrom   String?
  sharedDeck   String?
  sharedDeckId String?
  examples     Example[]
  reviewEvents ReviewEvent[]
  productionEvents ProductionEvent[]
  collections  Collection[] @relation("CollectionWords")

  // Duplicates are allowed on purpose: a user may keep several cards for the
  // same spelling (different senses, contexts, or a fresh repetition). So there
  // is no (userId, word) unique constraint — just an index for fast lookups.
  @@index([userId])
}

// A reading text the learner saved in the Reader, to return to later.
model ReaderText {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  content    String
  status     String   @default("ready") // ready | generating | failed
  collection String? // optional "read later"-style folder name
  translation String? // cached whole-text translation, saved with the text
  clickedWords String[] @default([]) // normalized keys of words the reader engaged with
  level      String? // estimated CEFR level of the text (e.g. "B2"), optional
  sourceLang String?
  targetLang String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, updatedAt])
}

// A coach scene playthrough, saved so the learner can browse past scenes and
// resume one mid-dialogue. The scene engine is stateless (the client echoes the
// bible every turn), so a row is the full resume state: bible + transcript +
// which mission words were used + corrections + report-card inputs. The Json
// blobs are never queried; `used`/`addedWords` are arrays so the history list
// can show studied words without loading the transcript.
model SceneSession {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  status        String   @default("active") // active | done
  sceneKey      String? // preset key ("bakery"…), null for generated scenes
  sourceLang    String?
  targetLang    String?
  bible         Json
  turns         Json     @default("[]")
  corrections   Json     @default("[]")
  used          String[] @default([])
  addedWords    String[] @default([])
  reviewedCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, updatedAt])
}

// One row per graded answer — the learner model's raw ledger. It used to hold
// only userId + time (an activity tick for streaks); the word, the grade and the
// venue it came from cannot be reconstructed afterwards, so they are logged from
// now on. Rows written before that stay valid activity ticks with a null wordId.
model ReviewEvent {
  id        String   @id @default(cuid())
  userId    String
  // The card that was graded. SetNull, not Cascade: deleting a word must not
  // rewrite the learner's past activity (streaks are counted off this table).
  wordId    String?
  word      Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  // FSRS Rating: 1=Again 2=Hard 3=Good 4=Easy. Null on pre-F2 rows.
  grade     Int?
  // Where the answer was given: review | quiz | drill | scene | chat, or cram
  // (logged only — a cram answer never moves the schedule).
  source    String   @default("review")
  // The card's schedule from just before this grade, so "Undo" can put it back
  // exactly (BACKLOG "Undo the last grade in review"). Null on cram rows and on
  // rows from before undo existed.
  prev      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([wordId, createdAt])
  @@index([userId, source, createdAt])
}

// One row per attempt to USE a word (say/write it), as opposed to recognising it
// on a card. Kept apart from ReviewEvent on purpose: a drill or scene answer used
// to be folded into an FSRS "Good", which made "recognises it" and "can use it"
// the same fact and threw the more valuable one away. Production never touches
// the recognition schedule — it only builds the ledger the "can use" count reads.
model ProductionEvent {
  id        String   @id @default(cuid())
  userId    String
  // SetNull like ReviewEvent: deleting a card must not rewrite past activity.
  wordId    String?
  word      Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  // How the attempt went: correct | partial | wrong.
  verdict   String
  // Where it was produced: drill | scene | chat.
  source    String   @default("drill")
  // What went wrong, when the coach could name it: meaning | form | collocation
  // | register. Null when the attempt was correct or the venue doesn't grade.
  errorKind String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([wordId, createdAt])
}

// The onboarding placement mini-test showed a themed word list and the learner
// tapped the ones they did NOT know. The taps became the starter deck and the
// rest — an explicit "I already know this" for every untapped word — was thrown
// away. It is the only free signal we get about words outside the deck (it feeds
// the readiness mark), so both sides of the answer are kept.
model PlacementAnswer {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       String
  sourceLang String
  targetLang String
  // The CEFR level the test was generated at, which is what makes "known" mean
  // something: knowing a B2 word is not the same claim as knowing an A1 one.
  level      String?
  known      Boolean
  createdAt  DateTime @default(now())

  // Re-taking the test overwrites the previous answer for the same word.
  @@unique([userId, word, sourceLang])
  @@index([userId, createdAt])
}

model Example {
  id         String   @id @default(cuid())
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  sentenceEn String
  sentenceZh String
  sourceName String
  sourceUrl  String
  // How an AI-composed example was generated, for display next to "Lexa AI":
  // register = the example style (casual/dialogue/literary/news); level = CEFR.
  // Null for web-mined and manual examples.
  register   String?
  level      String?
  createdAt  DateTime @default(now())
}

// Persistent usage counters for the free-tier quotas (daily AI pool + monthly
// feature caps). Stored in Postgres so a restart or a second instance can't reset
// or multiply a user's allowance — a prerequisite for real billing. The `key`
// encodes the period + user (+ feature), so a new day/month simply starts a fresh
// row; `resetAt` lets a sweep drop stale ones.
model UsageCounter {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// Durable Postgres-backed work queue for optional AI enrichment after a bulk
// import. Unlike an in-memory Promise, a job survives a Railway restart.
model ImportJob {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String   @default("queued") // queued | processing | completed | failed | cancelled
  total            Int
  processed        Int      @default(0)
  generateDetails  Boolean  @default(false)
  generateExamples Boolean  @default(false)
  level            String? // learner CEFR level for example difficulty
  exampleStyle     String? // news | casual | dialogue | literary
  exampleSource    String? // ai | web (default ai)
  cards            Json
  errors           String[]
  errorMessage     String?
  createdAt        DateTime @default(now())
  startedAt        DateTime?
  leaseUntil       DateTime?
  completedAt      DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Per-call LLM token log, so the owner admin dashboard can show real tokens +
// ¥ cost broken down by day / feature / model. Append-only and never queried by
// id (a BigInt isn't JSON-serializable), only aggregated — hence no relation.
// Written fire-and-forget from llm.ts logUsage; a DB hiccup must never break a
// request, so inserts swallow their own errors.
model TokenUsage {
  id               BigInt   @id @default(autoincrement())
  createdAt        DateTime @default(now())
  feature          String // coarse label, e.g. "gloss", "example.compose", "coachChat", "ocr", "asr"
  model            String // qwen-plus | qwen-flash | qwen-vl-plus | qwen3-asr-flash
  kind             String   @default("text") // text | ocr | asr
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  cachedTokens     Int      @default(0)
  ms               Int      @default(0)
  // Caller's telegramId (the session identity), from lib/usageContext. Null for
  // rows logged before per-user attribution or for calls outside any user's context.
  telegramId       String?

  @@index([createdAt])
  @@index([model])
  @@index([feature])
  @@index([telegramId])
}

// Product analytics — one append-only row per meaningful learner action, so the
// activation funnel (sign-in → first card → first review → first use-step),
// D1/D7/D30 retention and use-step completion are measurable. Kept in our own
// Postgres rather than a third-party tracker: no cookies, no IPs, no page views,
// only the handful of named events below, written server-side from the route that
// actually did the thing (a client can't forge them). Like TokenUsage: append-only,
// never read by id, written fire-and-forget so a DB hiccup can't break a request.
model AnalyticsEvent {
  id         BigInt   @id @default(autoincrement())
  createdAt  DateTime @default(now())
  name       String // signin | word_add | review | use_step
  // Caller's telegramId (the session identity), from lib/usageContext.
  telegramId String?
  surface    String   @default("web") // web | bot
  // Small, non-identifying detail: {via}, {mode}, {grade}, {kind, ok}.
  props      Json?

  @@index([createdAt])
  @@index([name, createdAt])
  @@index([telegramId, createdAt])
}
