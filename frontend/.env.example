# Frontend config. Public (NEXT_PUBLIC_*) vars are set in Vercel → Project →
# Settings → Environment Variables; BACKEND_URL is server-side only.

# --- Backend base URL ---
# LOCAL DEV: set this to the backend origin; the browser calls it directly.
# PRODUCTION (Vercel): LEAVE IT EMPTY. The browser then calls same-origin /api/*,
# which Next proxies to the backend via the rewrite in next.config.ts. Same-origin
# keeps the session/beta cookies first-party, so Safari (ITP) won't drop them the
# way it drops cross-site cookies from a split Vercel ↔ Railway deployment.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Server-side only (NOT bundled into the browser). The rewrite target for /api/*.
# On Vercel set this to the Railway backend public URL, e.g.
# https://your-backend.up.railway.app. next.config.ts reads it at BUILD time, so
# changing it needs a redeploy. Local dev only uses it if NEXT_PUBLIC_API_URL is empty.
BACKEND_URL="http://localhost:3000"

# Default account the web app shows (your Telegram numeric user id).
NEXT_PUBLIC_TELEGRAM_ID="dev-user"

# Username (without @) of the Telegram bot used for "Continue with Telegram".
# MUST be the same bot as the backend TELEGRAM_BOT_TOKEN (the one that runs the
# tutor bot), since deep-link login is confirmed by that bot. Locally that is your
# test bot (backend/.env.example → Telegram); on Vercel it is onomikabot.
NEXT_PUBLIC_BOT_USERNAME="onomika_dev_bot"

# The HSK focus pass. On (the default, set or not) the app shows one loop:
# Today · Words · Capture, with Community, friend profiles, the graphs, the extra
# quiz modes and the coach's own chat hidden. Set it to "off" to get the full
# build back — nothing was deleted. Keep it in step with the backend's FOCUS_MODE.
NEXT_PUBLIC_FOCUS_MODE="on"

# Google Sign-In client id (Google Cloud Console → Credentials → OAuth client).
# Authorise the site origin (e.g. http://localhost:3001) there. Empty hides it.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
